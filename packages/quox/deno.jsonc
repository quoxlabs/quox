{
  "name": "@quoxlabs/quox",
  "version": "0.0.5",
  "exports": {
    ".": "./mod.ts"
  },
  "license": "MIT",
  "tasks": {
    "wasmbuild": "deno run -A jsr:@deno/wasmbuild@0.21.1",
    "build": "deno task wasmbuild --debug --skip-opt",
    "build:prod": "deno task wasmbuild"
  },
  "publish": {
    "include": [
      "./mod.ts",
      "./dom/",
      "./lib/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
