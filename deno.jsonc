{
  "tasks": {
    "build": "cd packages/quox && deno task build",
    "build:prod": "cd packages/quox && deno task build:prod",
    "ok": "deno fmt --check && deno lint && deno test && deno check"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "workspace": ["./packages/font", "./packages/jsx", "./packages/quox", "./packages/winding"]
}
